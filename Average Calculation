// Calculating an average of three numbers
#include<stdio.h>
int main(){
    float a,b,c;
    printf("Enter First Number:\t");
    scanf("%f",&a);
    
    printf("Enter Second Number:\t");
    scanf("%f",&b);

    printf("Enter Third Number:\t");
    scanf("%f",&c);

    printf("Average of the Numbera is:\t%.2f", (a+b+c)/3);
    return 0;
}
